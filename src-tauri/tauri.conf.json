{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Looper",
  "version": "0.0.0",
  "identifier": "com.nova.v0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "The Looper",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/open-golf-coach-helper"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
