{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Looper",
  "version": "0.1.0",
  "identifier": "com.nova.v0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run helper:build:windows && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "The Looper",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "backgroundColor": "#0e1710",
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/open-golf-coach-helper"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzNkM1RTYxMTMxQjM0NDcKUldSSE5Cc1RZVjVzazMzV3NLMVNkbnZGQ2sycEdsaVdhVjQ4QnBKNXRaWUNiWG15c2VaY2FTUEMK",
      "endpoints": [
        "https://github.com/bpgpitt10/nova-v0/releases/latest/download/latest.json"
      ]
    }
  }
}
