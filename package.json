{
  "name": "nova-v0",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "architecture:check": "node tools/check-web-only-architecture.mjs",
    "courses:audit-runtime": "node tools/audit-course-runtime-contract.mjs",
    "courses:generate-registration": "node tools/generate-course-registration-index.mjs",
    "courses:validate-promotions": "node tools/check-course-promotions.mjs",
    "dev": "npm run architecture:check && npm run courses:generate-registration && vite",
    "build": "npm run architecture:check && npm run courses:validate-promotions && npm run courses:generate-registration && tsc -b && vite build",
    "lint": "npm run architecture:check && eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
