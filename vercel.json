{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "web-*": true,
      "auth-cloud-persistence": true,
      "course-geometry-package-v1": true
    }
  },
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{helpers/**,src-tauri/**,src/**,public/**,node_modules/**,dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
